# Copy this file to `.env` and adjust values for your environment.
# NEVER commit `.env` — it is ignored by git.

# --------------------------------------------------------------------------
# LLM (OpenAI-compatible endpoint)
#   Either set an explicit gateway (LLM_BASE_URL + LLM_MODEL) — e.g. OpenRouter
#   https://openrouter.ai/api/v1 with a free model like
#   google/gemma-4-31b-it:free — OR just set OPENAI_API_KEY and the pipeline
#   will talk to OpenAI directly using OPENAI_MODEL (default gpt-4o-mini).
#   Transient 429/5xx are auto-retried (LLM_MAX_RETRIES / LLM_BACKOFF_BASE).
# --------------------------------------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=google/gemma-4-31b-it:free
LLM_TIMEOUT=120
OPENAI_MODEL=gpt-4o-mini


MLFLOW_TRACKING_URI=http://192.168.50.35:5959
MLFLOW_EXPERIMENT_NAME=ali-workspace
MLFLOW_TRACKING_USERNAME=<your-username>
MLFLOW_TRACKING_PASSWORD=<your-password>
MLFLOW_GATEWAY_BASE_URL=http://192.168.50.35:5959/gateway/mlflow/v1
MLFLOW_WORKSPACE=ali-workspace   # workspace name sent as X-MLflow-Workspace
MLFLOW_GATEWAY_API_KEY=<gateway-api-key>   # optional; falls back to MLflow password


SCOPE=advisory

# --------------------------------------------------------------------------
# Milvus Standalone (Docker)
# --------------------------------------------------------------------------
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=legal
MILVUS_INSERT_BATCH_SIZE=256

# --------------------------------------------------------------------------
# Embedding / reranking backends
#   EMBEDDER_BACKEND: tfidf (offline default) | sentence_transformer | bge_m3
#   bge_m3 is the primary spec model (BAAI/bge-m3); it requires:
#       pip install FlagEmbedding   (pulls in torch)
#   RERANKER_BACKEND: none | cross_encoder | llm
#   cross_encoder uses BAAI/bge-reranker-base and also requires FlagEmbedding.
# --------------------------------------------------------------------------
EMBEDDER_BACKEND=tfidf
BGE_M3_MODEL=BAAI/bge-m3
RERANKER_BACKEND=none
RERANKER_MODEL=BAAI/bge-reranker-base

# --------------------------------------------------------------------------
# Qdrant hybrid RAG pipeline (retrieval/ + retrieval_graph/ + main_query.py)
# --------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=legal_hybrid
BGE_MODEL=BAAI/bge-m3              # query encoder (dense + sparse lexical)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # cross-encoder reranker
# RERANKER_BACKEND: auto (bge on GPU, fast on CPU) | bge | fast
#   "fast" uses the tiny cross-encoder/ms-marco-MiniLM-L-6-v2 (~0.05s/pair)
#   instead of bge-reranker-v2-m3 (~3.5s/pair on CPU).
RERANKER_BACKEND=auto

# --------------------------------------------------------------------------
# Hybrid retrieval + reranking
# --------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
HYBRID_CANDIDATE_LIMIT=20
RRF_K=60

# --------------------------------------------------------------------------
# Agent control-flow knobs
#   CONFIDENCE_THRESHOLD is tuned for tfidf (0.12); raise to 0.4-0.5 when
#   using real dense embeddings (sentence_transformer / bge_m3).
# --------------------------------------------------------------------------
MAX_HOPS=6
MAX_FALLBACK_RETRIES=2
MAX_TOOL_CALLS_TOTAL=8
GRAPH_LITE_MAX_EXPANSIONS=20
CONFIDENCE_THRESHOLD=0.12
RISK_THRESHOLD=0.7

# --------------------------------------------------------------------------
# Data / storage paths
# --------------------------------------------------------------------------
DATA_DIR=data/legal_docs
STATUTES_DIR=data
JUDGMENTS_DIR=data/Judgements
STORAGE_DIR=storage

# --------------------------------------------------------------------------
# PDF extraction quality thresholds (documents below these need OCR)
# --------------------------------------------------------------------------
PDF_MIN_TOTAL_CHARS=200
PDF_MIN_AVG_CHARS_PER_PAGE=30
PDF_MIN_NONEMPTY_RATIO=0.5

# --------------------------------------------------------------------------
# Neo4j knowledge graph (Graph/neo4j_store.py)
#   AuraDB (cloud): neo4j+s://<instance-id>.databases.neo4j.io
#   Local Docker:   bolt://localhost:7687
# --------------------------------------------------------------------------
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-password>
# NEO4J_DATABASE=neo4j
