# =====================================================================
# .gitignore — legal_multihop_agent
# =====================================================================

# ---- Python ----------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pkl

# ---- Virtual environments --------------------------------------------
.venv/
.venv-linux/
venv/
env/

# ---- Secrets / environment files -------------------------------------
# Real credentials live in .env — NEVER commit them.
.env
.env.*
!.env.example

# ---- Editors / OS ----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Logs / caches / test artefacts ----------------------------------
*.log
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Local Qdrant server data (1.6 GB) -------------------------------
qdrant_storage/

# ---- qdrant-store: KEEP the .py ingest scripts, IGNORE the big
#      pre-computed embedding JSONs (regenerable, ~110 MB) -------------
qdrant-store/*.json

# ---- Knowledge-graph build artefacts (regenerated by Graph/*.py) -----
Graph/graph_extracted.json
Graph/nodes.jsonl
Graph/edges.jsonl
Graph/assembly_summary.json
Graph/schema_report.json

# ---- Evaluation outputs (generated) ----------------------------------
evaluation/*.json

# ---- OPTIONAL: if you do NOT want to push the source PDF corpus -------
# (currently ~80 MB and already tracked — see note in README)
# data/
# chunks.json
# judgement_chunks.json